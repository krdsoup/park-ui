{
  "projectId": "2a3d6765-e18f-4bca-b733-fd78d651b62c",
  "pkg": "@park-ui/react",
  "globalName": "ParkUI",
  "shape": "storybook",
  "storybookConfigDir": "components/react/.storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "entry": "components/react/src/components/ui/index.ts",
  "cssEntry": "styled-system/styles.css",
  "tsconfig": "../../.design-sync/tsconfig.json",
  "extraEntries": [
    "@ark-ui/react/portal",
    "@ark-ui/react/collection",
    "@ark-ui/react/locale",
    "@ark-ui/react/carousel",
    "@ark-ui/react/file-upload",
    "../../.design-sync/entries/extras.mjs"
  ],
  "buildCmd": "npx -y bun@1.3.6 install --frozen-lockfile && (cd components/react && npx -y bun@1.3.6 run panda cssgen --config ../../.design-sync/panda.config.ts --outfile styled-system/styles.css) && node .design-sync/emit-dts.mjs",
  "storyImports": {
    "shim": ["/src/components/ui/index.ts", "/styled-system/jsx/index.mjs"]
  },
  "titleMap": {
    "Toast": "Toaster"
  },
  "provider": {
    "component": "LocaleProvider",
    "props": {
      "locale": "en-US"
    }
  },
  "overrides": {
    "Table": {
      "cardMode": "column"
    },
    "DisplayValue": {
      "skip": ["typography-displayvalue--basic"]
    }
  },
  "readmeHeader": ".design-sync/conventions.md"
}
